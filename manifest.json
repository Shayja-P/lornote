{
  "manifest_version": 3,
  "name": "Lornote",
  "version": "1.0.0",
  "description": "Timestamped YouTube notes with folders, tags, and library search.",
  "browser_specific_settings": {
    "gecko": {
      "id": "lornote@stela.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_title": "Lornote — open library",
    "default_icon": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage", "unlimitedStorage", "tabs"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["*://*.youtube.com/*"],
      "resources": ["icons/icon.svg"]
    }
  ]
}
